Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 24; 28; 34
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Scan points in odom
      Enabled: true
      Topic:
        Value: /scan_points
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 80; 210; 230
    - Class: rviz_default_plugins/LaserScan
      Name: Experimental reconstructed scan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 160; 70
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Scale: 180
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Width: 1200
  Height: 800
