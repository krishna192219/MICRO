Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Background Color: 24; 28; 34
    Frame Rate: 60
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: Wheel odometry - orange
      Enabled: true
      Topic:
        Value: /odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 10
        History Policy: Keep Last
      Keep: 1
      Color: 255; 160; 70
      Position Tolerance: 0.01
      Angle Tolerance: 0.03
    - Class: rviz_default_plugins/Odometry
      Name: Fused odometry - cyan
      Enabled: true
      Topic:
        Value: /odometry/filtered
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 10
        History Policy: Keep Last
      Keep: 1
      Color: 80; 210; 230
      Position Tolerance: 0.01
      Angle Tolerance: 0.03
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 180
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Width: 1200
  Height: 800
